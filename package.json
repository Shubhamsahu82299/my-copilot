{ 
  "publisher": "shubham",
  "repository": {
    "type": "git",
    "url": "hhttps://github.com/Shubhamsahu82299/my-copilot.git"
  },
  "name": "my-copilot",
  "displayName": "my-copilot",
  "description": "AI Coding and Debugging Assistant",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "my-copilot-sidebar",
          "title": "My Copilot",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "my-copilot-sidebar": [
        {
          "type": "webview",
          "id": "my-copilot.chatView",
          "name": "Copilot Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "my-copilot.readCode",
        "title": "Copilot: Read Active Code"
      },
      {
        "command": "my-copilot.getErrors",
        "title": "Copilot: Scan Current Errors"
      },
      {
        "command": "my-copilot.fixErrors",
        "title": "Copilot: Fix All Errors with AI"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  }
}
